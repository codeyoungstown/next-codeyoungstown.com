# The real value belongs in .env.local and Vercel, never in Git.
SLACK_INVITE_URL=https://join.slack.com/t/your-workspace/shared_invite/replace-me

# Optional in local development; required in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_KEY=

# Production defaults shown for clarity.
RECAPTCHA_ALLOWED_HOSTNAMES=codeyoungstown.com,www.codeyoungstown.com
RECAPTCHA_MIN_SCORE=0.6
